# ============================================
# BarberOS: variables de entorno (plantilla)
# ============================================

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto donde escucha la API
PORT=4000

# Cadena de conexión a MongoDB Atlas (con el nombre de la base al final)
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/barberos_dev?retryWrites=true&w=majority

# Origen permitido del frontend (CORS)
WEB_ORIGIN=http://localhost:3000

# Secretos de autenticación
JWT_ACCESS_SECRET=
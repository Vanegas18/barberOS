{
  "name": "barberos",
  "version": "0.1.0",
  "private": true,
  "description": "BarberOS: plataforma de gestión para barberías",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
      "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
      "typecheck": "pnpm -r run typecheck",
      "lint": "eslint .",
      "format": "prettier --write .",
      "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}